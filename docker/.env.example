# Oog - environment template.
#   cp .env.example .env     (Compose reads .env automatically; .env is git-ignored)
# All values are DEMO defaults for local use only; every password and secret below must be changed
# before the stack is used anywhere but on your own machine. compose.yaml carries the same defaults
# (keep them in sync), so the stack also starts without a .env file.

# --- Versions -------------------------------------------------------------------
# Tag of the self-built images oog/workbench, oog/rustfs-init, oog/postgres-init,
# oog/gitea-init. They are built on first use and never pulled; rebuild after changes with
# `docker compose build`.
OOG_IMAGE_TAG=0.1.0
# Upstream image tags. Postgres: keep 17.x; 18+ expects the data volume at /var/lib/postgresql
# and refuses to start with the mount used in compose.yaml.
RUSTFS_VERSION=1.0.4
POSTGRES_VERSION=17-alpine
# Gitea: the "-rootless" image of this version (also the base of oog/gitea-init).
GITEA_VERSION=28.2.0
# Build arguments of the self-built images.
CODE_SERVER_VERSION=4.144.0
# The version of aantje that the workbench image installs from Open VSX: a number (0.1.9) or latest. A new value rebuilds
# the install step on the next `docker compose up -d --build`; with latest Docker keeps the layer of the first build.
AANTJE_VERSION=latest
# DuckDB version of the quack server image (the version aantje ships); the extensions it needs are fetched at build time.
DUCKDB_VERSION=2.0.0

# --- Host ports (always published on 127.0.0.1 only) -----------------------------
# Only the host side changes; container ports and OOG_* endpoints stay as they are.
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
POSTGRES_PORT=5433
# code-server, plain HTTP (container port 8080)
WORKBENCH_PORT=8443
# Gitea web UI and API (container port 3000) and Git over SSH (container port 2222).
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
# Quack server (DuckDB, DuckLake catalog over TLS). Clients on this machine connect to localhost:9494.
QUACK_PORT=9494

# --- S3 / RustFS ----------------------------------------------------------------
# Endpoint as seen from inside the Compose network (not the published host port).
OOG_S3_ENDPOINT=http://rustfs:9000
OOG_S3_REGION=us-east-1
# Created by rustfs-init. Keep OOG_DUCKLAKE_DATA_PATH below inside this bucket.
OOG_S3_BUCKET=oog-lake
# Further buckets for rustfs-init, comma-separated. Must contain OOG_GITEA_BUCKET.
OOG_S3_EXTRA_BUCKETS=oog-gitea
# Root credentials of RustFS (RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY) and S3 client credentials.
OOG_S3_ACCESS_KEY=oogadmin
OOG_S3_SECRET_KEY=change-me-oog-secret

# --- Postgres (DuckLake catalog) ------------------------------------------------
# Host/port as seen from inside the Compose network. The server itself always listens
# on 5432; the host side is POSTGRES_PORT above.
OOG_PG_HOST=postgres
OOG_PG_PORT=5432
# Database, user and password are applied only when the data volume is created (first start).
# To change them later, reset with `docker compose down -v` (deletes all stack data).
OOG_PG_DB=ducklake
OOG_PG_USER=ducklake
OOG_PG_PASSWORD=change-me-pg

# --- DuckLake -------------------------------------------------------------------
# Alias used in ATTACH ... AS <name>.
OOG_DUCKLAKE_NAME=oog
# S3 location of the Parquet data files. Default: s3://<OOG_S3_BUCKET>/ducklake/ (it follows the bucket);
# set it only to force another path. An existing lake keeps the path stored in its catalog.
# OOG_DUCKLAKE_DATA_PATH=s3://oog-lake/ducklake/

# --- Gitea ----------------------------------------------------------------------
# Own database and login role on the Postgres server above, created by postgres-init (idempotent;
# the role password is synchronised on every run).
OOG_GITEA_DB=gitea
OOG_GITEA_DB_USER=gitea
OOG_GITEA_DB_PASSWORD=change-me-gitea-db
# Objects (attachments, LFS, packages, avatars) are stored in this RustFS bucket (see OOG_S3_EXTRA_BUCKETS).
OOG_GITEA_BUCKET=oog-gitea
# Address of Gitea as seen from the workbench (inside the Compose network).
OOG_GITEA_URL=http://gitea:3000
# Address of Gitea in the browser. Leave unset to derive it from GITEA_HTTP_PORT; set it when the
# stack is reached under another name or port.
# OOG_GITEA_ROOT_URL=http://localhost:3000/
# Admin account, created by gitea-init and used by the git credential helper of the workbench.
OOG_GITEA_ADMIN_USER=oogadmin
OOG_GITEA_ADMIN_EMAIL=admin@oog.local
# Private repository of the admin account with the folder notebooks/. gitea-init creates it with the
# examples as the first commit (only if it does not exist yet); the workbench clones it into
# /home/coder/workspace/<name> on its first start and opens it. Not a secret.
OOG_GITEA_REPO=oog-workspace
# At least 8 characters.
OOG_GITEA_ADMIN_PASSWORD=change-me-gitea
# Secrets of Gitea, mandatory (else a new value is generated whenever the container is re-created).
# SECRET_KEY encrypts data such as 2FA seeds: never change it after the first start.
# Both JWT secrets must be 32 random bytes as base64url without padding (43 characters), otherwise
# Gitea silently replaces them. Generate: docker run --rm docker.gitea.com/gitea:28.2.0-rootless gitea generate secret JWT_SECRET
OOG_GITEA_SECRET_KEY=oog-demo-gitea-secret-key-change-me-0123456789abcdefghijklmnopqr
OOG_GITEA_INTERNAL_TOKEN=oog-demo-gitea-internal-token-change-me
OOG_GITEA_JWT_SECRET=b29nLWRlbW8tb2F1dGgyLWp3dC1zZWNyZXQtMDAwMDE
OOG_GITEA_LFS_JWT_SECRET=b29nLWRlbW8tbGZzLWp3dC1zZWNyZXQtMDAwMDAwMDI

# --- Quack server ----------------------------------------------------------------
# Token that authenticates Quack clients (at least 4 characters). Demo value: change it. The server speaks TLS with a
# self-signed certificate that it creates once; the workbench trusts exactly that certificate.
OOG_QUACK_TOKEN=change-me-quack
# Where the workbench finds the server (the service name and the container port).
# OOG_QUACK_HOST=duckdb
# OOG_QUACK_PORT=9494

# --- Workbench ------------------------------------------------------------------
# Login password of code-server (http://localhost:8443). Demo value: change it.
OOG_CODE_SERVER_PASSWORD=change-me
# DuckDB extensions are preinstalled into the image at build time; this is the image
# default. Only change it together with the image build.
OOG_DUCKDB_EXTENSION_DIR=/opt/duckdb-extensions

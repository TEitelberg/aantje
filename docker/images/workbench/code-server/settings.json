{
    // Default user settings of the workbench. The entrypoint copies this file to
    // ~/.local/share/code-server/User/settings.json (a volume, so edits survive a re-created
    // container) when the user has none yet: later changes to this file do not reach an existing
    // volume. Settings that describe the image itself (interpreter, kernels) are in
    // machine-settings.json, which is rewritten on every start.
    // Workspace Trust is switched off by a flag in entrypoint.sh (it wins over any setting).

    // Quiet start: no telemetry, no update or experiment calls, no welcome tab.
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "update.showReleaseNotes": false,
    // An update is offered but never installed without a click; it lasts until the container is re-created.
    "extensions.autoUpdate": "off",
    "extensions.autoCheckUpdates": true,
    "extensions.ignoreRecommendations": true,
    "extensions.showRecommendationsOnlyOnDemand": true,
    "workbench.enableExperiments": false,
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "chat.disableAIFeatures": true,
    // No schema downloads (schemastore.org) and no npm registry lookups when editing JSON files.
    "json.schemaDownload.enable": false,
    "npm.fetchOnlinePackageInfo": false,

    // Python: no language server. Pylance is not on Open VSX, and the bundled Jedi server reports
    // every IPython magic (%%sql, %load_ext, ...) as a syntax error. In notebooks, completions
    // come from the running kernel (jupyter.enableKernelCompletions).
    "python.languageServer": "None",
    "python.terminal.activateEnvironment": false,
    "python.createEnvironment.trigger": "off",
    "python.experiments.enabled": false,

    // Jupyter: no confirmation dialogs.
    "jupyter.askForKernelRestart": false,
    "jupyter.askForLargeDataFrames": false,
    "jupyter.experiments.enabled": false
}

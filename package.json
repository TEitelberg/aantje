{
  "name": "aantje",
  "displayName": "aantje",
  "description": "Explorer and SQL editor for DuckLake catalogs (DuckDB, SQLite, PostgreSQL, DuckDB + Quack). The explorer is read-only; the SQL editor runs any SQL.",
  "version": "0.2.1",
  "publisher": "teitelberg",
  "author": {
    "name": "Tillmann Eitelberg"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TEitelberg/aantje.git"
  },
  "bugs": {
    "url": "https://github.com/TEitelberg/aantje/issues"
  },
  "homepage": "https://aantje.dev",
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "ducklake",
    "duckdb",
    "lakehouse",
    "catalog",
    "explorer",
    "postgresql",
    "sqlite",
    "quack",
    "sql"
  ],
  "qna": false,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "aantje reads no setting from the workspace: every setting has machine scope, and nothing in the workspace is run."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "aantje reads catalogs from local files and network connections."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aantje",
          "title": "aantje",
          "icon": "media/aantje-activity.svg"
        }
      ]
    },
    "views": {
      "aantje": [
        {
          "id": "aantje.catalogs",
          "name": "DuckLake Catalogs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aantje.catalogs",
        "contents": "No DuckLake connection yet.\nConnect to a DuckLake catalog that is stored in PostgreSQL, SQLite or DuckDB, or served by a DuckDB server over Quack.\n[Add Connection](command:aantje.addConnection)\n[Create Azure DuckLake](command:aantje.createAzureLake)"
      }
    ],
    "commands": [
      {
        "command": "aantje.addConnection",
        "title": "Add Connection...",
        "category": "aantje",
        "icon": "$(add)"
      },
      {
        "command": "aantje.editConnection",
        "title": "Edit Connection...",
        "category": "aantje",
        "icon": "$(edit)"
      },
      {
        "command": "aantje.removeConnection",
        "title": "Remove Connection",
        "category": "aantje",
        "icon": "$(trash)"
      },
      {
        "command": "aantje.createAzureLake",
        "title": "Create Azure DuckLake...",
        "category": "aantje",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aantje.finishAzureLake",
        "title": "Finish Creating Azure DuckLake...",
        "category": "aantje"
      },
      {
        "command": "aantje.importAzureLake",
        "title": "Import Azure DuckLake...",
        "category": "aantje"
      },
      {
        "command": "aantje.allowMyIp",
        "title": "Allow My IP",
        "category": "aantje"
      },
      {
        "command": "aantje.copyAzureConfig",
        "title": "Copy Azure Config",
        "category": "aantje"
      },
      {
        "command": "aantje.deleteAzureLake",
        "title": "Delete Azure DuckLake...",
        "category": "aantje",
        "icon": "$(trash)"
      },
      {
        "command": "aantje.testConnection",
        "title": "Test Connection",
        "category": "aantje"
      },
      {
        "command": "aantje.connect",
        "title": "Connect",
        "category": "aantje",
        "icon": "$(plug)"
      },
      {
        "command": "aantje.disconnect",
        "title": "Disconnect",
        "category": "aantje",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "aantje.refresh",
        "title": "Refresh",
        "category": "aantje",
        "icon": "$(refresh)"
      },
      {
        "command": "aantje.copyName",
        "title": "Copy Qualified Name",
        "category": "aantje"
      },
      {
        "command": "aantje.copyDdl",
        "title": "Copy DDL",
        "category": "aantje"
      },
      {
        "command": "aantje.scriptCreate",
        "title": "Script as CREATE",
        "category": "aantje"
      },
      {
        "command": "aantje.scriptSelect",
        "title": "Script as SELECT",
        "category": "aantje"
      },
      {
        "command": "aantje.scriptInsert",
        "title": "Script as INSERT",
        "category": "aantje"
      },
      {
        "command": "aantje.scriptAlter",
        "title": "Script as ALTER",
        "category": "aantje"
      },
      {
        "command": "aantje.scriptDrop",
        "title": "Script as DROP",
        "category": "aantje",
        "enablement": "viewItem != schema.main"
      },
      {
        "command": "aantje.maintenanceCheckpoint",
        "title": "Checkpoint",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceMerge",
        "title": "Merge Adjacent Files",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceRewrite",
        "title": "Rewrite Data Files",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceFlush",
        "title": "Flush Inlined Data",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceExpire",
        "title": "Expire Snapshots",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceCleanup",
        "title": "Clean Up Old Files",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceOrphans",
        "title": "Delete Orphaned Files",
        "category": "aantje"
      },
      {
        "command": "aantje.maintenanceOption",
        "title": "Set Option",
        "category": "aantje"
      },
      {
        "command": "aantje.selectSnapshot",
        "title": "Show Catalog at Snapshot...",
        "category": "aantje",
        "icon": "$(history)"
      },
      {
        "command": "aantje.showSnapshot",
        "title": "Show Catalog at this Snapshot",
        "category": "aantje",
        "icon": "$(target)"
      },
      {
        "command": "aantje.showProperties",
        "title": "Properties",
        "category": "aantje"
      },
      {
        "command": "aantje.showStorage",
        "title": "Storage Report",
        "category": "aantje"
      },
      {
        "command": "aantje.showLatestSnapshot",
        "title": "Show Latest Snapshot",
        "category": "aantje"
      },
      {
        "command": "aantje.search",
        "title": "Search Catalog...",
        "category": "aantje",
        "icon": "$(search)"
      },
      {
        "command": "aantje.previewTable",
        "title": "Select Top 1000 Rows",
        "category": "aantje",
        "icon": "$(table)"
      },
      {
        "command": "aantje.createNotebook",
        "title": "Create Notebook...",
        "category": "aantje",
        "icon": "$(notebook)"
      },
      {
        "command": "aantje.showStatistics",
        "title": "Statistics",
        "category": "aantje",
        "icon": "$(graph)"
      },
      {
        "command": "aantje.queryAtSnapshot",
        "title": "Query at Snapshot...",
        "category": "aantje"
      },
      {
        "command": "aantje.compareSchema",
        "title": "Compare Schema...",
        "category": "aantje"
      },
      {
        "command": "aantje.compareSnapshots",
        "title": "Compare Snapshots...",
        "category": "aantje"
      },
      {
        "command": "aantje.showChanges",
        "title": "Show Changes...",
        "category": "aantje"
      },
      {
        "command": "aantje.showSnapshotChanges",
        "title": "Show Rows Changed",
        "category": "aantje"
      },
      {
        "command": "aantje.showSnapshotReport",
        "title": "Snapshot Report",
        "category": "aantje",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "aantje.showSchemaHistory",
        "title": "Schema History",
        "category": "aantje"
      },
      {
        "command": "aantje.showActivity",
        "title": "Activity",
        "category": "aantje"
      },
      {
        "command": "aantje.showGrowth",
        "title": "Growth",
        "category": "aantje"
      },
      {
        "command": "aantje.showDependencies",
        "title": "Dependencies",
        "category": "aantje"
      },
      {
        "command": "aantje.showAdvisor",
        "title": "Maintenance Advisor",
        "category": "aantje"
      },
      {
        "command": "aantje.checkHealth",
        "title": "Check Health",
        "category": "aantje"
      },
      {
        "command": "aantje.checkTableHealth",
        "title": "Check Table Health",
        "category": "aantje"
      },
      {
        "command": "aantje.setS3Credentials",
        "title": "Set S3 Credentials...",
        "category": "aantje"
      },
      {
        "command": "aantje.clearS3Credentials",
        "title": "Clear S3 Credentials",
        "category": "aantje"
      },
      {
        "command": "aantje.revokeViewTrust",
        "title": "Revoke Trust in Views",
        "category": "aantje"
      },
      {
        "command": "aantje.newQuery",
        "title": "New Query",
        "category": "aantje"
      },
      {
        "command": "aantje.selectQueryConnection",
        "title": "Select Connection for Query...",
        "category": "aantje"
      },
      {
        "command": "aantje.runQuery",
        "title": "Run Query",
        "category": "aantje",
        "icon": "$(play)"
      },
      {
        "command": "aantje.runStatement",
        "title": "Run Statement at Cursor",
        "category": "aantje"
      },
      {
        "command": "aantje.cancelQuery",
        "title": "Cancel Query",
        "category": "aantje",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aantje.toggleResults",
        "title": "Toggle Results",
        "category": "aantje"
      },
      {
        "command": "aantje.hideResults",
        "title": "Hide Results",
        "category": "aantje",

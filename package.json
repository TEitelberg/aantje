    "configuration": {
      "title": "aantje",
      "properties": {
        "aantje.connections": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "markdownDescription": "DuckLake catalog connections. Passwords and tokens are never stored here; aantje keeps them in the VS Code secret storage. Use the **aantje: Add Connection** command instead of editing this by hand.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier of the connection (also the key of its stored password or token). Defaults to a slug of the name."
              },
              "name": {
                "type": "string",
                "description": "Display name in the explorer."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "postgres",
                  "sqlite",
                  "duckdb",
                  "quack"
                ],
                "description": "Where the DuckLake metadata is stored. quack: a DuckDB server that serves the catalog over the Quack protocol."
              },
              "host": {
                "type": "string",
                "description": "PostgreSQL host, or the host of the DuckDB server of a Quack catalog (any name but \"quack\")."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "default": 5432,
                "description": "PostgreSQL port, or the port of the Quack server. Absent: 5432 for PostgreSQL, 9494 for Quack."
              },
              "database": {
                "type": "string",
                "description": "PostgreSQL database."
              },
              "user": {
                "type": "string",
                "description": "PostgreSQL user."
              },
              "metadataSchema": {
                "type": "string",
                "description": "PostgreSQL schema that holds the ducklake_* tables (default: the connection's default schema)."
              },
              "azureAccount": {
                "type": "string",
                "description": "Azure storage account (ADLS Gen2) that holds the data files of the lake. aantje reads and writes them with the Microsoft account that VS Code is signed in with; no key is stored."
              },
              "azureAuth": {
                "type": "string",
                "enum": [
                  "password",
                  "entra"
                ],
                "default": "password",
                "description": "How an Azure lake signs in to PostgreSQL. entra: a token of the Microsoft account that VS Code is signed in with is the password, and \"user\" is its user principal name; no password is stored. password: the stored password."
              },
              "azureTenant": {
                "type": "string",
                "description": "Microsoft Entra tenant (ID) to sign in to for the storage account of an Azure lake. Without it the sign-in uses the home tenant of the account."
              },
              "ssl": {
                "type": "boolean",
                "description": "Use TLS for the PostgreSQL or Quack connection. Absent: TLS for every host but the local machine."
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}:?){31}[0-9A-Fa-f]{2}$",
                "description": "SHA-256 fingerprint of the certificate of a Quack server (64 hex digits, with or without colons), pinned instead of the system trust store; needs ssl. Add Connection reads it from the server and asks before it pins it."
              },
              "path": {
                "type": "string",
                "description": "SQLite or DuckDB database file that holds the ducklake_* tables."
              },
              "readOnly": {
                "type": "boolean",
                "description": "Open the SQL editor sessions of this connection read-only. A read-only session refuses statements that change the lake. Absent or false: writable. For a DuckDB file, a writable session locks the file exclusively, so the explorer cannot read it while the editor has it open. The explorer is read-only in either case. Not for quack: a Quack server has no file lock, and what its token may do is decided by the server."
              }
            }
          }
        },
        "aantje.queryTimeoutSeconds": {
          "type": "integer",
          "scope": "machine",
          "default": 30,
          "minimum": 1,
          "maximum": 86400,
          "markdownDescription": "Maximum duration, in seconds, of one catalog query and of one reading of table data (rows or the columns of a view). The time counts from the attach of the catalog. Installing the DuckDB extensions (the first download, about 40 MB) has its own limit of 5 minutes."
        },
        "aantje.s3.endpoint": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "S3 endpoint that holds the Parquet data of DuckLake catalogs, as `host:port` or `http(s)://host:port`. Empty means AWS. Used by **Select Top 1000 Rows**, and written into notebooks. The access key and secret are set with **aantje: Set S3 Credentials**."
        },
        "aantje.s3.region": {
          "type": "string",
          "scope": "machine",
          "default": "us-east-1",
          "markdownDescription": "S3 region for reading data."
        },
        "aantje.s3.urlStyle": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "path",
            "vhost"
          ],
          "default": "path",
          "markdownDescription": "How bucket names are put into S3 URLs. Most S3-compatible servers need `path`."
        },
        "aantje.duckdb.extensionDirectory": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Directory with the DuckDB extensions `ducklake`, `postgres`/`sqlite`/`quack` and `httpfs` for reading data. Empty uses the DuckDB default, which downloads them on first use and needs internet access. Set it for offline use."
        },
        "aantje.sql.maxRows": {
          "type": "integer",
          "scope": "machine",
          "default": 10000,
          "minimum": 1,
          "maximum": 1000000,
          "markdownDescription": "The most rows that the SQL editor keeps of one result. A longer result is cut and marked as partial; the rest is not read."
        }
      }
    }
  },

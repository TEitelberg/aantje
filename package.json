          "when": "false"
        },
        {
          "command": "aantje.maintenanceRewrite",
          "when": "false"
        },
        {
          "command": "aantje.maintenanceFlush",
          "when": "false"
        },
        {
          "command": "aantje.maintenanceExpire",
          "when": "false"
        },
        {
          "command": "aantje.maintenanceCleanup",
          "when": "false"

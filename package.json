      },
      {
        "command": "aantje.showResults",
        "title": "Show Results",
        "category": "aantje",
        "icon": "$(layout-panel-off)"
      },
      {
        "command": "aantje.toggleReadOnly",
        "title": "Toggle Read-only Session",
        "category": "aantje"
      },
      {
        "command": "aantje.queryMenu",
        "title": "Query Session...",
        "category": "aantje"
      }
    ],
    "keybindings": [
      {
        "command": "aantje.runQuery",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && aantje.queryEditor"
      },
      {
        "command": "aantje.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql && aantje.queryEditor"
      },
      {
        "command": "aantje.cancelQuery",
        "key": "shift+f5",
        "when": "editorTextFocus && editorLangId == sql && aantje.queryEditor && aantje.queryRunning"
      },
      {
        "command": "aantje.toggleResults",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus && editorLangId == sql && aantje.queryEditor && aantje.queryHasResults"
      }
    ],
    "submenus": [
      {
        "id": "aantje.script",
        "label": "Script as"
      },
      {
        "id": "aantje.maintenance",
        "label": "Maintenance"
      },
      {
        "id": "aantje.timeTravel",
        "label": "Time Travel"
      },
      {
        "id": "aantje.reports",
        "label": "Reports"
      }
    ],
    "menus": {
      "aantje.script": [
        {
          "command": "aantje.scriptSelect",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?|view(\\.azure)?|macro|column(\\.member)?|viewColumn|snapshot|detail\\.table|folder\\.(tables|views|macros|columns|viewColumns|partitioning|sortOrder|tags|statistics|history|snapshots))$/",
          "group": "1_select@1"
        },
        {
          "command": "aantje.scriptInsert",
          "when": "viewItem =~ /^table(\\.azure)?$/",
          "group": "1_select@2"
        },
        {
          "command": "aantje.scriptCreate",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?|view(\\.azure)?|macro|column|folder\\.(tables|views|macros|columns|partitioning|sortOrder))$/",
          "group": "2_define@1"
        },
        {
          "command": "aantje.scriptAlter",
          "when": "viewItem =~ /^(table(\\.azure)?|view(\\.azure)?|macro|column(\\.member)?|folder\\.(columns|partitioning|sortOrder|tags))$/",
          "group": "2_define@2"
        },
        {
          "command": "aantje.scriptDrop",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?|view(\\.azure)?|macro|column|folder\\.(tables|views|macros|columns|partitioning|sortOrder|tags))$/",
          "group": "3_drop"
        }
      ],
      "aantje.maintenance": [
        {
          "command": "aantje.maintenanceCheckpoint",
          "when": "viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "1_all@1"
        },
        {
          "command": "aantje.maintenanceMerge",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?)$/",
          "group": "2_files@2"
        },
        {
          "command": "aantje.maintenanceRewrite",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?)$/",
          "group": "2_files@3"
        },
        {
          "command": "aantje.maintenanceFlush",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?)$/",
          "group": "2_files@4"
        },
        {
          "command": "aantje.maintenanceExpire",
          "when": "viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "3_destructive@5"
        },
        {
          "command": "aantje.maintenanceCleanup",
          "when": "viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "3_destructive@6"
        },
        {
          "command": "aantje.maintenanceOrphans",
          "when": "viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "3_destructive@7"
        },
        {
          "command": "aantje.maintenanceOption",
          "when": "viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?)$/",
          "group": "4_options@8"
        }
      ],
      "view/title": [
        {
          "command": "aantje.addConnection",
          "when": "view == aantje.catalogs",
          "group": "navigation@1"
        },
        {
          "command": "aantje.search",
          "when": "view == aantje.catalogs",
          "group": "navigation@2"
        },
        {
          "command": "aantje.refresh",
          "when": "view == aantje.catalogs",
          "group": "navigation@3"
        },
        {
          "command": "aantje.createAzureLake",
          "when": "view == aantje.catalogs",
          "group": "1_azure@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aantje.connect",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.(disconnected|error)(\\.azure)?$/",
          "group": "inline@1"
        },
        {
          "command": "aantje.disconnect",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "inline@1"
        },
        {
          "command": "aantje.selectSnapshot",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "inline@2"
        },
        {
          "command": "aantje.refresh",
          "when": "view == aantje.catalogs && viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|folder\\.(tables|views|macros)|table(\\.azure)?|view(\\.azure)?)$/",
          "group": "inline@3"
        },
        {
          "command": "aantje.showSnapshot",
          "when": "view == aantje.catalogs && viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "aantje.showSnapshot",
          "when": "view == aantje.catalogs && viewItem == snapshot",
          "group": "1_snapshot@1"
        },
        {
          "command": "aantje.showSnapshotChanges",
          "when": "view == aantje.catalogs && viewItem == detail.table",
          "group": "1_changes@1"
        },
        {
          "command": "aantje.testConnection",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\./",
          "group": "1_connection@1"
        },
        {
          "command": "aantje.editConnection",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\./",
          "group": "1_connection@2"
        },
        {
          "command": "aantje.removeConnection",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\./",
          "group": "1_connection@3"
        },
        {
          "command": "aantje.copyName",
          "when": "view == aantje.catalogs && viewItem =~ /^(schema(\\.main)?|table(\\.azure)?|view(\\.azure)?|column(\\.member)?|viewColumn)$/",
          "group": "2_copy@1"
        },
        {
          "command": "aantje.copyDdl",
          "when": "view == aantje.catalogs && viewItem =~ /^(table(\\.azure)?|view(\\.azure)?)$/",
          "group": "2_copy@2"
        },
        {
          "command": "aantje.newQuery",
          "when": "view == aantje.catalogs && viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?|view(\\.azure)?)$/",
          "group": "2_query@1"
        },
        {
          "submenu": "aantje.script",
          "when": "view == aantje.catalogs && viewItem =~ /^(column|column\\.member|connection\\.connected(\\.azure)?|detail\\.table|macro|schema(\\.main)?|snapshot|table(\\.azure)?|view(\\.azure)?|viewColumn|folder\\.(columns|history|macros|partitioning|snapshots|sortOrder|statistics|tables|tags|viewColumns|views))$/",
          "group": "2_script"
        },
        {
          "submenu": "aantje.maintenance",
          "when": "view == aantje.catalogs && viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?)$/",
          "group": "2_script_maintenance"
        },
        {
          "submenu": "aantje.timeTravel",
          "when": "view == aantje.catalogs && viewItem =~ /^(table(\\.azure)?|view(\\.azure)?)$/",
          "group": "2_travel"
        },
        {
          "command": "aantje.compareSnapshots",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "2_travel@1"
        },
        {
          "command": "aantje.selectSnapshot",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "2_travel@2"
        },
        {
          "command": "aantje.showLatestSnapshot",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.connected(\\.azure)?$/",
          "group": "2_travel@3"
        },
        {
          "command": "aantje.previewTable",
          "when": "view == aantje.catalogs && viewItem =~ /^(table(\\.azure)?|view(\\.azure)?)$/",
          "group": "3_data@1"
        },
        {
          "command": "aantje.createNotebook",
          "when": "view == aantje.catalogs && viewItem =~ /^(table|view)$/",
          "group": "3_data@2"
        },
        {
          "submenu": "aantje.reports",
          "when": "view == aantje.catalogs && viewItem =~ /^(connection\\.connected(\\.azure)?|schema(\\.main)?|table(\\.azure)?|view(\\.azure)?|macro)$/",
          "group": "3_reports"
        },
        {
          "command": "aantje.showStatistics",
          "when": "view == aantje.catalogs && viewItem == folder.statistics",
          "group": "3_data@3"
        },
        {
          "command": "aantje.showStatistics",
          "when": "view == aantje.catalogs && viewItem == folder.statistics",
          "group": "inline@1"
        },
        {
          "command": "aantje.allowMyIp",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.(connected|disconnected|error)\\.azure$/",
          "group": "9_azure@0"
        },
        {
          "command": "aantje.copyAzureConfig",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.(connected|disconnected|error)\\.azure$/",
          "group": "9_azure@1"
        },
        {
          "command": "aantje.deleteAzureLake",
          "when": "view == aantje.catalogs && viewItem =~ /^connection\\.(connected|disconnected|error)\\.azure$/",
          "group": "9_azure@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aantje.showSnapshot",
